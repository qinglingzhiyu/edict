{
  "agents": {
    "defaults": {
      "model": {
        "primary": "alibailian/qwen3-max-2026-01-23"
      }
    },
    "list": [
      {"id": "pmo",      "workspace": "/app/.openclaw/workspace-pmo",      "subagents": {"allowAgents": ["product"]}},
      {"id": "product",  "workspace": "/app/.openclaw/workspace-product",  "subagents": {"allowAgents": ["pmo", "ui", "frontend", "backend", "qa"]}},
      {"id": "ui",       "workspace": "/app/.openclaw/workspace-ui",       "subagents": {"allowAgents": ["product", "frontend"]}},
      {"id": "frontend", "workspace": "/app/.openclaw/workspace-frontend", "subagents": {"allowAgents": ["product", "backend", "qa"]}},
      {"id": "backend",  "workspace": "/app/.openclaw/workspace-backend",  "subagents": {"allowAgents": ["product", "frontend", "qa"]}},
      {"id": "qa",       "workspace": "/app/.openclaw/workspace-qa",       "subagents": {"allowAgents": ["product", "frontend", "backend", "ops"]}},
      {"id": "ops",      "workspace": "/app/.openclaw/workspace-ops",      "subagents": {"allowAgents": ["qa", "pmo"]}}
    ]
  },
  "providers": {}
}
